<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <FrameLayout
            android:id="@+id/arrow_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:clickable="true">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_back"
                app:tint="@color/main_icon_text"
                android:layout_gravity="center"/>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting"
            android:textColor="@color/main_icon_text"
            android:textSize="@dimen/main_size"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/set_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/night"
            android:textColor="@color/black"
            android:textSize="@dimen/set_size"
            android:layout_marginStart="@dimen/set_marg_left"
            android:layout_gravity="center_vertical|start"/>

        <Switch
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:switchMinWidth="56dp"
            android:layout_marginEnd="6dp"/>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/set_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            android:textColor="@color/black"
            android:textSize="@dimen/set_size"
            android:layout_marginStart="@dimen/set_marg_left"
            android:layout_gravity="center_vertical|start"/>

        <FrameLayout
            android:layout_width="@dimen/set_icon_size"
            android:layout_height="@dimen/set_icon_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/set_icon_marg_end">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/share"
                app:tint="@color/set_gray"
                android:layout_gravity="center"/>

        </FrameLayout>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/set_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help"
            android:textColor="@color/black"
            android:textSize="@dimen/set_size"
            android:layout_marginStart="@dimen/set_marg_left"
            android:layout_gravity="center_vertical|start"/>

        <FrameLayout
            android:layout_width="@dimen/set_icon_size"
            android:layout_height="@dimen/set_icon_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/set_icon_marg_end">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/support"
                app:tint="@color/set_gray"
                android:layout_gravity="center"/>

        </FrameLayout>

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/set_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/set_marg_left"
            android:text="@string/doc"
            android:textColor="@color/black"
            android:textSize="@dimen/set_size" />

        <FrameLayout
            android:layout_width="@dimen/set_icon_size"
            android:layout_height="@dimen/set_icon_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/set_icon_marg_end">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow_forward"
                app:tint="@color/set_gray"
                android:layout_gravity="center"/>

        </FrameLayout>

    </FrameLayout>

</LinearLayout>