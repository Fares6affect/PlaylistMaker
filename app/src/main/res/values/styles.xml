<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MainMain">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/main_back</item>
    </style>

    <style name="MainActivityButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="cornerRadius">@dimen/main_but_rad</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginHorizontal">16dp</item>
    </style>

    <style name="SetSerBack">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/set_sear_back_activity</item>
        <item name ="android:orientation">vertical</item>
    </style>

    <style name="SettingActivityTextRev">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical|start</item>
        <item name="android:layout_marginStart">@dimen/set_marg_left</item>
        <item name="android:textColor">@color/set_text_rev</item>
        <item name="android:textSize">@dimen/set_size</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="SettingActivityIconRev">
        <item name="android:layout_width">@dimen/set_icon_size</item>
        <item name="android:layout_height">@dimen/set_icon_size</item>
        <item name="android:layout_gravity">center_vertical|end</item>
        <item name="android:layout_marginEnd">@dimen/set_icon_marg_end</item>
        <item name="tint">@color/set_icon_rev</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="ArrowThemeActivity">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="tint">@color/theme_text_activity</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="TextThemeActivity">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/theme_text_activity</item>
        <item name="android:textSize">@dimen/main_size</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

</resources>